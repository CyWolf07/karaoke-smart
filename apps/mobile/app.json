{
  "expo": {
    "name": "Karaoke Smart",
    "slug": "karaoke-smart",
    "scheme": "karaokesmart",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0b",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Karaoke Smart usa la cámara solo para escanear el código QR de la sala.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.karaokesmart.app",
      "permissions": ["CAMERA"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "extra": {
      "apiUrl": "https://karaoke-smart.onrender.com",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5e84776b-6375-4dcd-aad6-57166fa895b1"
      }
    },
    "owner": "cywolfs-team"
  }
}
